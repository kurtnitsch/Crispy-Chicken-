name: Crispy Chicken Benchmark

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  run_benchmark:
    runs-on: ubuntu-latest

    steps:
      # 1️⃣ Checkout repo
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2️⃣ Install dependencies
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.11"

      - name: Install Python packages
        run: |
          python -m pip install --upgrade pip
          pip install psutil

      - name: Install Rust (for WASM build)
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          target: wasm32-unknown-unknown
          override: true

      - name: Install DFX (Internet Computer SDK)
        run: |
          curl -fsSL https://internetcomputer.org/install.sh | sh
          source "$HOME/.cache/dfx/dfx-env.sh" || true

      # 3️⃣ Start local DFX replica
      - name: Start local DFX replica
        run: |
          dfx start --background --clean
          sleep 5

      # 4️⃣ Build Crispy Chicken (WASM / Rust example)
      - name: Build WASM artifacts
        run: |
          cargo build --release --target wasm32-unknown-unknown || true
          for f in target/wasm32-unknown-unknown/release/*.wasm; do
            wasm-opt -Oz -o ${f%.wasm}.opt.wasm "$f" || true
          done

      # 5️⃣ Run maximum benchmark
      - name: Run Maximum-Hardness Benchmark
        run: |
          python benchmarks/run_bench_max.py

      # 6️⃣ Upload results as artifacts
      - name: Upload benchmark artifacts
        uses: actions/upload-artifact@v4
        with:
          name: crispy-chicken-benchmarks
          path: |
            benchmarks/bench_results_max.json
            benchmarks/bench_results_max.csv

      # 7️⃣ Stop DFX replica
      - name: Stop DFX
        run: dfx stop || true
