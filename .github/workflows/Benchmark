#!/usr/bin/env python3
"""
Crispy Chicken OS Benchmark Harness
-----------------------------------
Benchmarks core scenarios:
- Model load times (CrispyFS vs baseline file IO)
- Inference latency (native vs verified ICP mode)
- Swarm coordination latency (FLOCK manager)
- Energy consumption per task (optional, Linux-only)
- Memory footprint

Outputs:
- JSON with metadata + results
- CSV with flat results for plotting
"""

import os, sys, time, json, csv, subprocess, statistics, platform, psutil, hashlib, random
from datetime import datetime

OUT_JSON = "bench_results.json"
OUT_CSV  = "bench_results.csv"
N_RUNS   = 30  # samples per benchmark
WARMUP   = 3   # warm-up runs ignored in stats

# ---------------------------
# Metadata helpers
# ---------------------------

def get_git_commit():
    try:
        return subprocess.getoutput("git rev-parse --short HEAD").strip()
    except Exception:
        return "unknown"

def get_dfx_version():
    return subprocess.getoutput("dfx --version").strip()

def get_cpu_info():
    return {
        "cpu": platform.processor(),
        "cores": os.cpu_count(),
        "freq": psutil.cpu_freq()._asdict() if psutil.cpu_freq() else {}
    }

def get_mem_info():
    vm = psutil.virtual_memory()
    return {"total_gb": round(vm.total/1e9,2)}

def meta_info():
    return {
        "timestamp": datetime.utcnow().isoformat(),
        "git_commit": get_git_commit(),
        "dfx_version": get_dfx_version(),
        "platform": platform.platform(),
        "cpu": get_cpu_info(),
        "memory": get_mem_info(),
        "env": {k:v for k,v in os.environ.items() if k.startswith("CI") or k.startswith("DFX")}
    }

# ---------------------------
# Benchmark primitives
# ---------------------------

def run_cmd(cmd):
    """Run command, return runtime in ms."""
    t0 = time.perf_counter()
    subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return (time.perf_counter()-t0)*1000.0

def stats(samples):
    return {
        "n": len(samples),
        "median_ms": statistics.median(samples),
        "mean_ms": statistics.mean(samples),
        "stdev_ms": statistics.stdev(samples) if len(samples)>1 else 0,
        "p95_ms": sorted(samples)[int(0.95*len(samples))-1],
        "raw": samples
    }

# ---------------------------
# Energy measurement (Linux RAPL)
# ---------------------------

def read_energy_uj(domain="package-0"):
    path = f"/sys/class/powercap/intel-rapl:0/energy_uj"
    try:
        with open(path) as f:
            return int(f.read().strip())
    except Exception:
        return None

def measure_energy(cmd):
    e0 = read_energy_uj()
    t0 = time.perf_counter()
    subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    e1 = read_energy_uj()
    t1 = time.perf_counter()
    if e0 and e1:
        return {"energy_j": (e1-e0)/1e6, "time_ms": (t1-t0)*1000.0}
    return None

# ---------------------------
# Scenario wrappers
# ---------------------------

def bench_model_load():
    samples=[]
    for i in range(N_RUNS+WARMUP):
        ms=run_cmd("python tools/load_model.py --mode crispyfs --file models/test.bin")
        if i>=WARMUP: samples.append(ms)
    return stats(samples)

def bench_inference(verified=True):
    mode = "--verified" if verified else "--native"
    samples=[]
    for i in range(N_RUNS+WARMUP):
        ms=run_cmd(f"python tools/invoke_inference.py --input examples/x.json {mode}")
        if i>=WARMUP: samples.append(ms)
    return stats(samples)

def bench_swarm_coord():
    samples=[]
    for i in range(N_RUNS+WARMUP):
        ms=run_cmd("python tools/swarm_message.py --agents 100")
        if i>=WARMUP: samples.append(ms)
    return stats(samples)

def bench_proof_verification():
    samples=[]
    for i in range(N_RUNS+WARMUP):
        ms=run_cmd("python tools/verify_proof.py --file proofs/proof1.json")
        if i>=WARMUP: samples.append(ms)
    return stats(samples)

# ---------------------------
# Main
# ---------------------------

def main():
    results = {"meta": meta_info(), "benchmarks": {}}

    print("[*] Running Crispy Chicken OS Benchmarks...")

    results["benchmarks"]["model_load"] = bench_model_load()
    results["benchmarks"]["inference_native"] = bench_inference(verified=False)
    results["benchmarks"]["inference_verified"] = bench_inference(verified=True)
    results["benchmarks"]["swarm_coord"] = bench_swarm_coord()
    results["benchmarks"]["proof_verification"] = bench_proof_verification()

    # Save JSON
    with open(OUT_JSON,"w") as f:
        json.dump(results,f,indent=2)
    print(f"[+] Wrote {OUT_JSON}")

    # Flatten to CSV
    with open(OUT_CSV,"w",newline="") as f:
        writer=csv.writer(f)
        writer.writerow(["scenario","median_ms","mean_ms","stdev_ms","p95_ms","n"])
        for k,v in results["benchmarks"].items():
            writer.writerow([k,v["median_ms"],v["mean_ms"],v["stdev_ms"],v["p95_ms"],v["n"]])
    print(f"[+] Wrote {OUT_CSV}")

if __name__=="__main__":
    main()
